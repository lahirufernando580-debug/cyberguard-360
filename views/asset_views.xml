<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ ASSETS -->
    <record id="cg_asset_view_search" model="ir.ui.view">
        <field name="name">cg.asset.search</field>
        <field name="model">cg.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Asset" filter_domain="['|', '|', ('name', 'ilike', self), ('hostname', 'ilike', self), ('ip_address', 'ilike', self)]"/>
                <field name="ip_address"/>
                <field name="wazuh_agent_id"/>
                <field name="owner_id"/>
                <field name="department"/>
                <filter name="critical" string="Critical" domain="[('criticality', '=', 'critical')]"/>
                <filter name="high" string="High" domain="[('criticality', '=', 'high')]"/>
                <separator/>
                <filter name="internet_facing" string="Internet Facing" domain="[('internet_facing', '=', True)]"/>
                <filter name="my_assets" string="My Assets" domain="[('owner_id', '=', uid)]"/>
                <separator/>
                <filter name="agent_active" string="Agent Active" domain="[('agent_status', '=', 'active')]"/>
                <filter name="agent_offline" string="Agent Offline" domain="[('agent_status', 'in', ('disconnected', 'never_connected'))]"/>
                <filter name="no_agent" string="No Agent" domain="[('agent_status', '=', 'none')]"/>
                <separator/>
                <filter name="status_active" string="In Service" domain="[('status', '=', 'active')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'asset_type'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_criticality" string="Criticality" context="{'group_by': 'criticality'}"/>
                    <filter name="group_agent" string="Agent Status" context="{'group_by': 'agent_status'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department'}"/>
                    <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="cg_asset_view_list" model="ir.ui.view">
        <field name="name">cg.asset.list</field>
        <field name="model">cg.asset</field>
        <field name="arch" type="xml">
            <list decoration-muted="status in ('inactive', 'retired')" class="cg_glass_view">
                <field name="name" class="fw-bold"/>
                <field name="asset_type"/>
                <field name="ip_address" class="cg_mono"/>
                <field name="operating_system" optional="show"/>
                <field name="owner_id" widget="many2one_avatar_user" optional="show"/>
                <field name="department" optional="show"/>
                <field name="criticality" widget="badge" decoration-danger="criticality == 'critical'" decoration-warning="criticality == 'high'" decoration-info="criticality == 'medium'" decoration-muted="criticality == 'low'"/>
                <field name="internet_facing" widget="boolean_toggle" readonly="1" optional="show"/>
                <field name="wazuh_agent_id" class="cg_mono" optional="show"/>
                <field name="agent_status" widget="badge" decoration-success="agent_status == 'active'" decoration-danger="agent_status == 'disconnected'" decoration-warning="agent_status in ('never_connected', 'pending')" decoration-muted="agent_status == 'none'"/>
                <field name="open_alert_count" string="Open Alerts"/>
                <field name="vulnerability_count" string="Vulns"/>
                <field name="risk_score" widget="progressbar" string="Exposure"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-warning="status == 'maintenance'" decoration-muted="status in ('inactive', 'retired')" optional="show"/>
            </list>
        </field>
    </record>

    <record id="cg_asset_view_kanban" model="ir.ui.view">
        <field name="name">cg.asset.kanban</field>
        <field name="model">cg.asset</field>
        <field name="arch" type="xml">
            <kanban class="cg_kanban cg_glass_view">
                <field name="criticality"/>
                <field name="agent_status"/>
                <field name="risk_band"/>
                <field name="internet_facing"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="cg_card cg_edge_{{record.risk_band.raw_value}}">
                            <div class="d-flex align-items-start justify-content-between">
                                <div>
                                    <field name="name" class="cg_card_title"/>
                                    <div class="cg_card_sub"><field name="asset_type"/> · <field name="operating_system"/></div>
                                </div>
                                <span t-attf-class="cg_dot cg_dot_{{record.agent_status.raw_value}}" t-att-title="record.agent_status.value"/>
                            </div>
                            <div class="cg_card_meta">
                                <span class="cg_mono"><field name="ip_address"/></span>
                                <span t-if="record.internet_facing.raw_value" class="cg_chip cg_chip_warn">Internet facing</span>
                            </div>
                            <div class="cg_score_row">
                                <div class="cg_score_bar"><span t-attf-class="cg_fill_{{record.risk_band.raw_value}}" t-attf-style="width: {{record.risk_score.raw_value}}%"/></div>
                                <span class="cg_score_num"><field name="risk_score"/></span>
                            </div>
                            <footer class="cg_card_foot">
                                <span><i class="fa fa-bell-o me-1" title="Alerts"/><field name="open_alert_count"/> alerts</span>
                                <span><i class="fa fa-bug me-1" title="Vulnerabilities"/><field name="vulnerability_count"/> vulns</span>
                                <field name="criticality" widget="badge" class="ms-auto" decoration-danger="criticality == 'critical'" decoration-warning="criticality == 'high'" decoration-info="criticality == 'medium'" decoration-muted="criticality == 'low'"/>
                                <field name="owner_id" widget="many2one_avatar_user"/>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="cg_asset_view_form" model="ir.ui.view">
        <field name="name">cg.asset.form</field>
        <field name="model">cg.asset</field>
        <field name="arch" type="xml">
            <form class="cg_glass_view">
                <header>
                    <button name="action_set_inactive" type="object" string="Mark Inactive" invisible="status != 'active'"/>
                    <button name="action_set_active" type="object" string="Return to Service" class="btn-primary" invisible="status == 'active'"/>
                    <field name="status" widget="statusbar" statusbar_visible="active,maintenance,inactive,retired" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_alerts" icon="fa-bell-o">
                            <field name="open_alert_count" widget="statinfo" string="Open Alerts"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_vulnerabilities" icon="fa-bug">
                            <field name="vulnerability_count" widget="statinfo" string="Vulnerabilities"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_risks" icon="fa-balance-scale">
                            <field name="risk_count" widget="statinfo" string="Risks"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_incidents" icon="fa-fire">
                            <field name="incident_count" widget="statinfo" string="Incidents"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. WEB-PROD-01"/></h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="asset_type"/>
                            <field name="category_id"/>
                            <field name="hostname" class="cg_mono"/>
                            <field name="ip_address" class="cg_mono"/>
                            <field name="mac_address" class="cg_mono"/>
                            <field name="operating_system"/>
                            <field name="location"/>
                        </group>
                        <group string="Business Context">
                            <field name="owner_id" widget="many2one_avatar_user"/>
                            <field name="department"/>
                            <field name="criticality"/>
                            <field name="internet_facing"/>
                            <field name="risk_score" widget="progressbar"/>
                            <field name="risk_band" widget="badge" decoration-danger="risk_band == 'critical'" decoration-warning="risk_band == 'high'" decoration-info="risk_band == 'medium'" decoration-success="risk_band == 'low'"/>
                        </group>
                    </group>
                    <group string="Wazuh Agent">
                        <group>
                            <field name="wazuh_agent_id" class="cg_mono" placeholder="e.g. 003"/>
                            <field name="agent_status" widget="badge" decoration-success="agent_status == 'active'" decoration-danger="agent_status == 'disconnected'" decoration-warning="agent_status in ('never_connected', 'pending')" decoration-muted="agent_status == 'none'"/>
                        </group>
                        <group>
                            <field name="agent_version"/>
                            <field name="agent_last_keepalive"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Alerts" name="alerts" groups="cyberguard_360.group_cg_analyst">
                            <field name="alert_ids" readonly="1">
                                <list limit="15" default_order="timestamp desc">
                                    <field name="timestamp"/>
                                    <field name="name"/>
                                    <field name="src_ip" class="cg_mono"/>
                                    <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-info="severity == 'medium'" decoration-muted="severity == 'low'"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Vulnerabilities" name="vulnerabilities" groups="cyberguard_360.group_cg_analyst">
                            <field name="vulnerability_ids" readonly="1">
                                <list>
                                    <field name="cve_id" class="cg_mono"/>
                                    <field name="name"/>
                                    <field name="cvss_score"/>
                                    <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-info="severity == 'medium'" decoration-muted="severity == 'low'"/>
                                    <field name="priority" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Risks" name="risks" groups="cyberguard_360.group_cg_analyst">
                            <field name="risk_ids" readonly="1">
                                <list>
                                    <field name="reference" class="cg_mono"/>
                                    <field name="name"/>
                                    <field name="score"/>
                                    <field name="level" widget="badge" decoration-danger="level == 'critical'" decoration-warning="level == 'high'" decoration-info="level == 'medium'" decoration-success="level == 'low'"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Incidents" name="incidents" groups="cyberguard_360.group_cg_analyst">
                            <field name="incident_ids" readonly="1">
                                <list>
                                    <field name="reference" class="cg_mono"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-info="severity == 'medium'" decoration-muted="severity == 'low'"/>
                                    <field name="stage" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Anything the security team should know about this asset..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cg_asset_action" model="ir.actions.act_window">
        <field name="name">IT Assets</field>
        <field name="res_model">cg.asset</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first IT asset</p>
            <p>Add servers, endpoints and network devices, then link each one to its Wazuh agent so alerts land on the right asset.</p>
        </field>
    </record>

    <record id="cg_agent_action" model="ir.actions.act_window">
        <field name="name">Wazuh Agents</field>
        <field name="res_model">cg.asset</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('agent_status', '!=', 'none')]</field>
        <field name="context">{'search_default_group_agent': 1}</field>
    </record>

    <!-- ============================================================ CATEGORIES -->
    <record id="cg_asset_category_view_list" model="ir.ui.view">
        <field name="name">cg.asset.category.list</field>
        <field name="model">cg.asset.category</field>
        <field name="arch" type="xml">
            <list editable="bottom" class="cg_glass_view">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" class="cg_mono"/>
                <field name="description"/>
                <field name="asset_count"/>
            </list>
        </field>
    </record>

    <record id="cg_asset_category_action" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">cg.asset.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
