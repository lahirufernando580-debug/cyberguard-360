<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ ACTIVITY LOG (UM08) -->
    <record id="cg_activity_log_view_search" model="ir.ui.view">
        <field name="name">cg.activity.log.search</field>
        <field name="model">cg.activity.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="res_name"/>
                <filter name="auth" string="Authentication" domain="[('category', '=', 'auth')]"/>
                <filter name="admin" string="Administration" domain="[('category', '=', 'admin')]"/>
                <filter name="response" string="Automation and Response" domain="[('category', '=', 'automation')]"/>
                <separator/>
                <filter name="filter_date" date="create_date"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_category" string="Area" context="{'group_by': 'category'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="cg_activity_log_view_list" model="ir.ui.view">
        <field name="name">cg.activity.log.list</field>
        <field name="model">cg.activity.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" class="cg_glass_view">
                <field name="create_date" string="When"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="category" widget="badge"/>
                <field name="name"/>
                <field name="res_name"/>
                <field name="details" optional="show"/>
                <field name="res_id" column_invisible="1"/>
                <button name="action_open_record" type="object" icon="fa-external-link" string="Open" invisible="not res_id"/>
            </list>
        </field>
    </record>

    <record id="cg_activity_log_action" model="ir.actions.act_window">
        <field name="name">User Activity Logs</field>
        <field name="res_model">cg.activity.log</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No activity recorded yet</p>
            <p>Logins, approvals, AI requests and other important actions appear here. Entries cannot be edited.</p>
        </field>
    </record>

    <!-- ============================================================ USERS (UM03-UM07, UM09) -->
    <record id="cg_users_action" model="ir.actions.act_window">
        <field name="name">Users and Roles</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('share', '=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Invite your team</p>
            <p>Create a user, then choose their CyberGuard 360 role: Employee, Analyst, Manager or Administrator.</p>
        </field>
    </record>

    <!-- ============================================================ SETTINGS -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cyberguard</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="CyberGuard 360" string="CyberGuard 360" name="cyberguard_360" groups="cyberguard_360.group_cg_admin">
                    <block title="AI Security Analyst">
                        <setting string="AI engine" help="The built-in engine works offline. Claude gives richer, free-form analysis. Only structured event summaries are ever sent: never credentials or database access.">
                            <field name="cg_ai_provider" widget="radio"/>
                            <div class="content-group mt-2" invisible="cg_ai_provider != 'claude'">
                                <div class="row">
                                    <label for="cg_ai_api_key" class="col-lg-4 o_light_label"/>
                                    <field name="cg_ai_api_key" password="True" class="col-lg-8"/>
                                </div>
                                <div class="row mt-1">
                                    <label for="cg_ai_model" class="col-lg-4 o_light_label"/>
                                    <field name="cg_ai_model" class="col-lg-8"/>
                                </div>
                                <div class="text-muted mt-1">Requires the <code>anthropic</code> Python package on the Odoo server.</div>
                            </div>
                        </setting>
                    </block>
                    <block title="Threat Intelligence">
                        <setting help="Off by default. When enabled, analysts can send a single indicator value (an IP, domain or file hash) to VirusTotal. Log content and internal addresses are never sent.">
                            <field name="cg_ti_external_enabled"/>
                            <div class="content-group mt-2" invisible="not cg_ti_external_enabled">
                                <div class="row">
                                    <label for="cg_virustotal_api_key" class="col-lg-4 o_light_label"/>
                                    <field name="cg_virustotal_api_key" password="True" class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="abuse.ch ThreatFox" help="Import recent malicious indicators of compromise from ThreatFox. This feed adds external intelligence records; it does not create endpoint alerts. Needs external lookups to be allowed above.">
                            <field name="cg_threatfox_api_key" password="True" placeholder="Auth-Key"/>
                            <div class="text-muted mt-1">ThreatFox requires an Auth-Key for every request. It is free at <a href="https://auth.abuse.ch/" target="_blank" rel="noopener noreferrer">auth.abuse.ch</a>.</div>
                        </setting>
                        <setting string="NIST NVD" help="Optional API key for higher CVE lookup rate limits.">
                            <field name="cg_nvd_api_key" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="cg_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'cyberguard_360', 'bin_size': False}</field>
    </record>
</odoo>
