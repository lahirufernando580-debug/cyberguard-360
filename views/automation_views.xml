<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ NOTIFICATIONS -->
    <record id="cg_notification_view_search" model="ir.ui.view">
        <field name="name">cg.notification.search</field>
        <field name="model">cg.notification</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="unread" string="Unread" domain="[('is_read', '=', False)]"/>
                <filter name="mine" string="Addressed to Me" domain="[('user_ids', 'in', [uid])]"/>
                <separator/>
                <filter name="critical" string="Critical" domain="[('severity', '=', 'critical')]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'ntype'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="cg_notification_view_list" model="ir.ui.view">
        <field name="name">cg.notification.list</field>
        <field name="model">cg.notification</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-bf="not is_read" decoration-muted="is_read" class="cg_glass_view">
                <header>
                    <button name="action_mark_read" type="object" string="Mark Read"/>
                </header>
                <field name="create_date" string="When"/>
                <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-info="severity == 'medium'" decoration-muted="severity == 'low'"/>
                <field name="ntype" widget="badge"/>
                <field name="name"/>
                <field name="message" optional="show"/>
                <field name="user_ids" widget="many2many_avatar_user" optional="show"/>
                <field name="is_read" column_invisible="1"/>
                <button name="action_open_record" type="object" string="Open" icon="fa-external-link" invisible="not res_id"/>
                <field name="res_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="cg_notification_action" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">cg.notification</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_unread': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">You are all caught up</p>
        </field>
    </record>

    <!-- ============================================================ AUTOMATION RULES -->
    <record id="cg_automation_rule_view_list" model="ir.ui.view">
        <field name="name">cg.automation.rule.list</field>
        <field name="model">cg.automation.rule</field>
        <field name="arch" type="xml">
            <list class="cg_glass_view">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="trigger" widget="badge"/>
                <field name="min_severity"/>
                <field name="keyword" optional="show"/>
                <field name="repeat_threshold" optional="show"/>
                <field name="action" widget="badge" decoration-info="action == 'notify'" decoration-warning="action in ('create_incident', 'create_risk')" decoration-danger="action == 'recommend_response'"/>
                <field name="run_count"/>
                <field name="last_run"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="cg_automation_rule_view_form" model="ir.ui.view">
        <field name="name">cg.automation.rule.form</field>
        <field name="model">cg.automation.rule</field>
        <field name="arch" type="xml">
            <form class="cg_glass_view">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Brute force: create an incident"/></h1>
                    </div>
                    <div class="cg_split">
                        <div class="cg_panel">
                            <h3>When</h3>
                            <group>
                                <field name="trigger"/>
                                <field name="min_severity"/>
                                <field name="keyword"/>
                                <field name="repeat_threshold" invisible="trigger != 'alert'"/>
                            </group>
                        </div>
                        <div class="cg_panel">
                            <h3>Then</h3>
                            <group>
                                <field name="action"/>
                                <field name="notify_role" invisible="action != 'notify'"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                            <p class="cg_hint" invisible="action != 'recommend_response'">
                                Response actions are only recommended. A manager must approve each one before it runs.
                            </p>
                            <p class="cg_hint" invisible="trigger == 'alert' or action == 'notify'">
                                Creating incidents, risks and response actions applies to alert triggers. Other triggers can send notifications.
                            </p>
                        </div>
                    </div>
                    <group>
                        <field name="description"/>
                    </group>
                    <group>
                        <group><field name="run_count"/></group>
                        <group><field name="last_run"/></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cg_automation_rule_action" model="ir.actions.act_window">
        <field name="name">Automation Rules</field>
        <field name="res_model">cg.automation.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- ============================================================ RESPONSE ACTIONS -->
    <record id="cg_response_action_view_search" model="ir.ui.view">
        <field name="name">cg.response.action.search</field>
        <field name="model">cg.response.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="target"/>
                <filter name="pending" string="Awaiting Approval" domain="[('state', '=', 'recommended')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="executed" string="Executed" domain="[('state', '=', 'executed')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Action" context="{'group_by': 'action_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="cg_response_action_view_list" model="ir.ui.view">
        <field name="name">cg.response.action.list</field>
        <field name="model">cg.response.action</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" class="cg_glass_view">
                <field name="create_date" string="Requested"/>
                <field name="name"/>
                <field name="action_type" widget="badge"/>
                <field name="target" class="cg_mono"/>
                <field name="asset_id"/>
                <field name="incident_id" optional="show"/>
                <field name="requested_by" widget="many2one_avatar_user" optional="show"/>
                <field name="approved_by" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'recommended'" decoration-warning="state == 'approved'" decoration-success="state == 'executed'" decoration-danger="state == 'failed'" decoration-muted="state == 'rejected'"/>
                <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'recommended'" groups="cyberguard_360.group_cg_manager"/>
                <button name="action_execute" type="object" string="Execute" invisible="state != 'approved'" groups="cyberguard_360.group_cg_manager"/>
            </list>
        </field>
    </record>

    <record id="cg_response_action_view_form" model="ir.ui.view">
        <field name="name">cg.response.action.form</field>
        <field name="model">cg.response.action</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" class="cg_glass_view">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'recommended'" groups="cyberguard_360.group_cg_manager"/>
                    <button name="action_execute" type="object" string="Execute via Wazuh" class="btn-primary" invisible="state != 'approved'" groups="cyberguard_360.group_cg_manager"
                            confirm="Run this response action now?"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state not in ('recommended', 'approved')" groups="cyberguard_360.group_cg_manager"/>
                    <button name="action_retry" type="object" string="Retry" invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="recommended,approved,executed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Action">
                            <field name="action_type"/>
                            <field name="target" class="cg_mono"/>
                            <field name="asset_id" domain="[('wazuh_agent_id', '!=', False)]"/>
                        </group>
                        <group string="Context">
                            <field name="alert_id"/>
                            <field name="incident_id"/>
                            <field name="requested_by" widget="many2one_avatar_user"/>
                            <field name="approved_by" widget="many2one_avatar_user"/>
                            <field name="executed_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="result" class="cg_mono" invisible="not result"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cg_response_action_action" model="ir.actions.act_window">
        <field name="name">Response Actions</field>
        <field name="res_model">cg.response.action</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No response actions</p>
            <p>CyberGuard recommends actions such as blocking an address. Nothing runs until a manager approves it.</p>
        </field>
    </record>
</odoo>
