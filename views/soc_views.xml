<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ ALERTS -->
    <record id="cg_alert_view_search" model="ir.ui.view">
        <field name="name">cg.alert.search</field>
        <field name="model">cg.alert</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Alert" filter_domain="['|', '|', '|', ('name', 'ilike', self), ('full_log', 'ilike', self), ('agent_name', 'ilike', self), ('src_ip', 'ilike', self)]"/>
                <field name="src_ip"/>
                <field name="dst_ip"/>
                <field name="agent_name" string="Hostname"/>
                <field name="asset_id"/>
                <field name="rule_id"/>
                <field name="rule_groups"/>
                <field name="mitre_technique_ids"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('new', 'acknowledged', 'investigating'))]"/>
                <filter name="new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="mine" string="Assigned to Me" domain="[('assigned_to', '=', uid)]"/>
                <separator/>
                <filter name="critical" string="Critical" domain="[('severity', '=', 'critical')]"/>
                <filter name="high" string="High" domain="[('severity', '=', 'high')]"/>
                <filter name="medium" string="Medium" domain="[('severity', '=', 'medium')]"/>
                <filter name="low" string="Low" domain="[('severity', '=', 'low')]"/>
                <separator/>
                <filter name="repeated" string="Recurring" domain="[('is_repeated', '=', True)]"/>
                <filter name="unlinked" string="No Asset Linked" domain="[('asset_id', '=', False)]"/>
                <filter name="no_incident" string="Not in an Incident" domain="[('incident_id', '=', False)]"/>
                <separator/>
                <filter name="last_24h" string="Last 24 Hours" domain="[('timestamp', '>=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="last_7d" string="Last 7 Days" domain="[('timestamp', '>=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_timestamp" date="timestamp"/>
                <group>
                    <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                    <filter name="group_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
                    <filter name="group_agent" string="Agent" context="{'group_by': 'agent_name'}"/>
                    <filter name="group_rule" string="Rule" context="{'group_by': 'rule_id'}"/>
                    <filter name="group_src" string="Source IP" context="{'group_by': 'src_ip'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'timestamp:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="cg_alert_view_list" model="ir.ui.view">
        <field name="name">cg.alert.list</field>
        <field name="model">cg.alert</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-muted="state in ('resolved', 'false_positive')" decoration-bf="state == 'new'" class="cg_glass_view">
                <header>
                    <button name="action_acknowledge" type="object" string="Acknowledge"/>
                    <button name="action_ai_analyse" type="object" string="Analyse with AI" class="btn-primary"/>
                    <button name="action_create_incident" type="object" string="Create Incident"/>
                    <button name="action_create_risk" type="object" string="Create Risk"/>
                    <button name="action_resolve" type="object" string="Resolve"/>
                </header>
                <field name="timestamp"/>
                <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-info="severity == 'medium'" decoration-muted="severity == 'low'"/>
                <field name="name"/>
                <field name="asset_id" optional="show"/>
                <field name="agent_name" optional="hide"/>
                <field name="src_ip" class="cg_mono" optional="show"/>
                <field name="dst_user" optional="hide"/>
                <field name="rule_id" class="cg_mono" optional="show"/>
                <field name="rule_level" optional="show"/>
                <field name="mitre_technique_ids" widget="many2many_tags" optional="show"/>
                <field name="repeat_count" string="24h" optional="show"/>
                <field name="incident_id" optional="hide"/>
                <field name="assigned_to" widget="many2one_avatar_user" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-warning="state in ('acknowledged', 'investigating')" decoration-success="state == 'resolved'" decoration-muted="state == 'false_positive'"/>
            </list>
        </field>
    </record>

    <record id="cg_alert_view_form" model="ir.ui.view">
        <field name="name">cg.alert.form</field>
        <field name="model">cg.alert</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" class="cg_glass_view">
                <header>
                    <button name="action_ai_explain" type="object" string="Explain with AI" class="btn-primary" icon="fa-magic"/>
                    <button name="action_acknowledge" type="object" string="Acknowledge" invisible="state != 'new'"/>
                    <button name="action_investigate" type="object" string="Investigate" invisible="state not in ('new', 'acknowledged')"/>
                    <button name="action_create_incident" type="object" string="Create Incident" invisible="incident_id"/>
                    <button name="action_create_risk" type="object" string="Create Risk" invisible="risk_id"/>
                    <button name="action_block_source" type="object" string="Recommend IP Block" invisible="not src_ip"/>
                    <button name="action_resolve" type="object" string="Resolve" invisible="state in ('resolved', 'false_positive')"/>
                    <button name="action_false_positive" type="object" string="False Positive" invisible="state in ('resolved', 'false_positive')"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state not in ('resolved', 'false_positive')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,acknowledged,investigating,resolved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_related" icon="fa-clone">
                            <field name="repeat_count" widget="statinfo" string="In 24h"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_analyses" icon="fa-magic">
                            <field name="analysis_count" widget="statinfo" string="AI Analyses"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="cg_ref"><field name="reference"/></span>
                        <h1><field name="name" readonly="wazuh_id"/></h1>
                        <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-info="severity == 'medium'" decoration-muted="severity == 'low'"/>
                    </div>
                    <group>
                        <group string="Detection">
                            <field name="timestamp"/>
                            <field name="rule_id" class="cg_mono"/>
                            <field name="rule_level"/>
                            <field name="rule_groups"/>
                            <field name="mitre_technique_ids" widget="many2many_tags"/>
                            <field name="decoder"/>
                            <field name="location"/>
                        </group>
                        <group string="Where and Who">
                            <field name="asset_id"/>
                            <field name="asset_criticality" widget="badge" decoration-danger="asset_criticality == 'critical'" decoration-warning="asset_criticality == 'high'" decoration-info="asset_criticality == 'medium'" invisible="not asset_id"/>
                            <field name="agent_name"/>
                            <field name="agent_id" class="cg_mono"/>
                            <field name="src_ip" class="cg_mono"/>
                            <field name="dst_ip" class="cg_mono"/>
                            <field name="src_user"/>
                            <field name="dst_user"/>
                        </group>
                    </group>
                    <group>
                        <group string="Handling">
                            <field name="assigned_to" widget="many2one_avatar_user"/>
                            <field name="incident_id"/>
                            <field name="risk_id"/>
                        </group>
                        <group string="Import">
                            <field name="wazuh_id" class="cg_mono"/>
                            <field name="group_key" class="cg_mono"/>
                            <field name="is_repeated"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Full Log" name="log">
                            <field name="full_log" class="cg_log" readonly="wazuh_id" placeholder="Raw log line..."/>
                        </page>
                        <page string="Raw Event" name="raw" invisible="not raw_json">
                            <field name="raw_json" class="cg_log" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cg_alert_view_graph" model="ir.ui.view">
        <field name="name">cg.alert.graph</field>
        <field name="model">cg.alert</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1" class="cg_glass_view">
                <field name="timestamp" interval="day"/>
                <field name="severity"/>
            </graph>
        </field>
    </record>

    <record id="cg_alert_view_pivot" model="ir.ui.view">
        <field name="name">cg.alert.pivot</field>
        <field name="model">cg.alert</field>
        <field name="arch" type="xml">
            <pivot class="cg_glass_view">
                <field name="asset_id" type="row"/>
                <field name="severity" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="cg_alert_action" model="ir.actions.act_window">
        <field name="name">Security Alerts</field>
        <field name="res_model">cg.alert</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No alerts match</p>
            <p>Alerts are imported from Wazuh. Run a sync from SOC &gt; Wazuh Connection.</p>
        </field>
    </record>

    <record id="cg_alert_critical_action" model="ir.actions.act_window">
        <field name="name">Critical Alerts</field>
        <field name="res_model">cg.alert</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1, 'search_default_critical': 1, 'search_default_high': 1}</field>
    </record>

    <record id="cg_alert_recurring_action" model="ir.actions.act_window">
        <field name="name">Recurring Alert Patterns</field>
        <field name="res_model">cg.alert</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_repeated': 1, 'search_default_group_rule': 1}</field>
    </record>

    <!-- ============================================================ WAZUH CONNECTION -->
    <record id="cg_wazuh_config_view_form" model="ir.ui.view">
        <field name="name">cg.wazuh.config.form</field>
        <field name="model">cg.wazuh.config</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" class="cg_glass_view">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary" icon="fa-plug"/>
                    <button name="action_sync_alerts" type="object" string="Sync Alerts" icon="fa-refresh"/>
                    <button name="action_sync_agents" type="object" string="Sync Agents" icon="fa-desktop"/>
                    <button name="action_sync_vulnerabilities" type="object" string="Sync Vulnerabilities" icon="fa-bug"/>
                    <button name="action_fetch_history" type="object" string="Import History" icon="fa-history"/>
                    <field name="state" widget="statusbar" statusbar_visible="not_tested,connected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <div class="text-muted"><field name="last_message" readonly="1"/></div>
                    </div>
                    <group>
                        <group string="Mode">
                            <field name="mode" widget="radio"/>
                        </group>
                        <group string="Synchronisation">
                            <field name="last_sync"/>
                            <field name="alerts_imported"/>
                            <field name="last_alert_timestamp" class="cg_mono"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="mode != 'demo'">
                        Demo mode generates realistic alerts locally so every workflow can be shown without a Wazuh server.
                        Switch to <strong>Live Wazuh Server</strong> and fill in the connection details to use real data.
                    </div>
                    <group invisible="mode != 'live'">
                        <group string="Indexer API (alerts)">
                            <field name="indexer_url" placeholder="https://wazuh-indexer:9200" required="mode == 'live'"/>
                            <field name="indexer_user"/>
                            <field name="indexer_password" password="True"/>
                            <field name="index_pattern" class="cg_mono"/>
                        </group>
                        <group string="Server API (agents, active response)">
                            <field name="api_url" placeholder="https://wazuh-manager:55000" required="mode == 'live'"/>
                            <field name="api_user"/>
                            <field name="api_password" password="True"/>
                            <field name="verify_ssl"/>
                        </group>
                    </group>
                    <group>
                        <group string="Import Rules">
                            <field name="min_level"/>
                            <field name="batch_size"/>
                            <field name="history_days"/>
                        </group>
                        <group string="Automation">
                            <field name="auto_sync"/>
                            <field name="auto_create_assets"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cg_wazuh_config_action" model="ir.actions.act_window">
        <field name="name">Wazuh Connection</field>
        <field name="res_model">cg.wazuh.config</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="wazuh_config_default"/>
    </record>
</odoo>
