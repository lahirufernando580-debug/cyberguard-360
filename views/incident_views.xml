<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cg_incident_view_search" model="ir.ui.view">
        <field name="name">cg.incident.search</field>
        <field name="model">cg.incident</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Incident" filter_domain="['|', ('name', 'ilike', self), ('reference', 'ilike', self)]"/>
                <field name="analyst_id"/>
                <field name="asset_ids"/>
                <filter name="open" string="Open" domain="[('stage', '!=', 'closed')]"/>
                <filter name="mine" string="Assigned to Me" domain="[('analyst_id', '=', uid)]"/>
                <filter name="unassigned" string="Unassigned" domain="[('analyst_id', '=', False)]"/>
                <filter name="reported_by_me" string="Reported by Me" domain="[('reporter_id', '=', uid)]"/>
                <separator/>
                <filter name="critical" string="Critical" domain="[('severity', '=', 'critical')]"/>
                <filter name="high" string="High" domain="[('severity', '=', 'high')]"/>
                <separator/>
                <filter name="escalated" string="Escalated" domain="[('escalated', '=', True)]"/>
                <filter name="overdue" string="Past SLA" domain="[('stage', 'in', ('new', 'triage', 'investigating')), ('sla_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="closed" string="Closed" domain="[('stage', '=', 'closed')]"/>
                <group>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                    <filter name="group_analyst" string="Analyst" context="{'group_by': 'analyst_id'}"/>
                    <filter name="group_month" string="Month Detected" context="{'group_by': 'detected_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="cg_incident_view_list" model="ir.ui.view">
        <field name="name">cg.incident.list</field>
        <field name="model">cg.incident</field>
        <field name="arch" type="xml">
            <list decoration-muted="stage == 'closed'" decoration-danger="is_overdue" class="cg_glass_view">
                <field name="reference" class="cg_mono"/>
                <field name="name"/>
                <field name="category"/>
                <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-info="severity == 'medium'" decoration-muted="severity == 'low'"/>
                <field name="asset_ids" widget="many2many_tags" optional="show"/>
                <field name="analyst_id" widget="many2one_avatar_user"/>
                <field name="detected_date"/>
                <field name="sla_deadline" optional="show"/>
                <field name="escalated" optional="show"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="stage" widget="badge" decoration-info="stage in ('new', 'triage')" decoration-warning="stage == 'investigating'" decoration-success="stage in ('contained', 'eradicated', 'closed')"/>
            </list>
        </field>
    </record>

    <record id="cg_incident_view_kanban" model="ir.ui.view">
        <field name="name">cg.incident.kanban</field>
        <field name="model">cg.incident</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" class="cg_kanban cg_glass_view">
                <field name="severity"/>
                <field name="is_overdue"/>
                <field name="escalated"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="cg_card cg_edge_{{record.severity.raw_value}}">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="cg_mono cg_card_sub"><field name="reference"/></span>
                                <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-info="severity == 'medium'" decoration-muted="severity == 'low'"/>
                            </div>
                            <field name="name" class="cg_card_title"/>
                            <div class="cg_card_sub"><field name="category"/></div>
                            <div class="cg_card_meta">
                                <span t-if="record.is_overdue.raw_value" class="cg_chip cg_chip_danger">Past SLA</span>
                                <span t-if="record.escalated.raw_value" class="cg_chip cg_chip_warn">Escalated</span>
                            </div>
                            <field name="asset_ids" widget="many2many_tags"/>
                            <footer class="cg_card_foot">
                                <span><i class="fa fa-bell-o me-1" title="Alerts"/><field name="alert_count"/></span>
                                <span class="ms-auto text-muted"><field name="detected_date" widget="date"/></span>
                                <field name="analyst_id" widget="many2one_avatar_user"/>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="cg_incident_view_form" model="ir.ui.view">
        <field name="name">cg.incident.form</field>
        <field name="model">cg.incident</field>
        <field name="arch" type="xml">
            <form class="cg_glass_view">
                <header>
                    <button name="action_next_stage" type="object" string="Advance Stage" class="btn-primary" invisible="stage == 'closed'" groups="cyberguard_360.group_cg_analyst"/>
                    <button name="action_ai_analysis" type="object" string="AI Incident Analysis" icon="fa-magic" groups="cyberguard_360.group_cg_analyst"/>
                    <button name="action_recommend_response" type="object" string="Recommend Response" icon="fa-shield" invisible="stage == 'closed'" groups="cyberguard_360.group_cg_analyst"/>
                    <button name="action_assign_to_me" type="object" string="Assign to Me" invisible="analyst_id" groups="cyberguard_360.group_cg_analyst"/>
                    <button name="action_escalate" type="object" string="Escalate" invisible="stage == 'closed'" groups="cyberguard_360.group_cg_analyst"/>
                    <button name="action_close" type="object" string="Close Incident" invisible="stage == 'closed'" groups="cyberguard_360.group_cg_analyst"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="stage != 'closed'" groups="cyberguard_360.group_cg_analyst"/>
                    <button name="action_print" type="object" string="Incident Report" icon="fa-print" groups="cyberguard_360.group_cg_analyst"/>
                    <field name="stage" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Past SLA" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <field name="is_overdue" invisible="1"/>
                    <div class="oe_title">
                        <span class="cg_ref"><field name="reference"/></span>
                        <h1><field name="name" placeholder="What happened?"/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="category"/>
                            <field name="severity"/>
                            <field name="analyst_id" widget="many2one_avatar_user"/>
                            <field name="reporter_id" widget="many2one_avatar_user"/>
                        </group>
                        <group string="Timeline">
                            <field name="detected_date"/>
                            <field name="sla_deadline"/>
                            <field name="contained_date" invisible="not contained_date"/>
                            <field name="closed_date" invisible="not closed_date"/>
                            <field name="escalated" invisible="not escalated"/>
                            <field name="escalation_level" invisible="not escalated"/>
                            <field name="escalated_to" invisible="not escalated"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe what was observed..."/>
                        <field name="asset_ids" widget="many2many_tags"/>
                    </group>

                    <div class="cg_panel cg_panel_hypo" invisible="not ai_summary">
                        <h3><i class="fa fa-magic me-2"/>AI summary</h3>
                        <field name="ai_summary"/>
                        <h3 class="mt-3">Recommended response</h3>
                        <field name="recommended_actions"/>
                    </div>

                    <notebook>
                        <page string="Timeline" name="timeline">
                            <field name="timeline_html" readonly="1"/>
                        </page>
                        <page string="Investigation Notes" name="notes">
                            <field name="note_ids">
                                <list editable="top">
                                    <field name="date"/>
                                    <field name="note_type" widget="badge" decoration-info="note_type == 'finding'" decoration-success="note_type == 'action'" decoration-warning="note_type == 'evidence'" decoration-muted="note_type == 'system'"/>
                                    <field name="content"/>
                                    <field name="author_id" widget="many2one_avatar_user"/>
                                </list>
                            </field>
                        </page>
                        <page string="Linked Alerts" name="alerts" groups="cyberguard_360.group_cg_analyst">
                            <field name="alert_ids" widget="many2many" domain="[('incident_id', '=', False)]">
                                <list>
                                    <field name="timestamp"/>
                                    <field name="name"/>
                                    <field name="asset_id"/>
                                    <field name="src_ip" class="cg_mono"/>
                                    <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-info="severity == 'medium'" decoration-muted="severity == 'low'"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Evidence" name="evidence" groups="cyberguard_360.group_cg_analyst">
                            <field name="evidence_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Response Actions" name="response" groups="cyberguard_360.group_cg_analyst">
                            <field name="response_action_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="name"/>
                                    <field name="action_type"/>
                                    <field name="target" class="cg_mono"/>
                                    <field name="state" widget="badge" decoration-info="state == 'recommended'" decoration-warning="state == 'approved'" decoration-success="state == 'executed'" decoration-danger="state == 'failed'" decoration-muted="state == 'rejected'"/>
                                    <button name="action_approve" type="object" string="Approve" invisible="state != 'recommended'" groups="cyberguard_360.group_cg_manager"/>
                                    <button name="action_execute" type="object" string="Execute" invisible="state != 'approved'" groups="cyberguard_360.group_cg_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="Resolution" name="resolution">
                            <group>
                                <field name="root_cause" placeholder="Why did this happen?"/>
                                <field name="resolution" placeholder="Required before closing: what was done to resolve it?"/>
                                <field name="lessons_learned" placeholder="What should change so it does not happen again?"/>
                            </group>
                        </page>
                        <page string="AI Analyses" name="analyses" invisible="not analysis_ids" groups="cyberguard_360.group_cg_analyst">
                            <field name="analysis_ids" readonly="1">
                                <list>
                                    <field name="reference" class="cg_mono"/>
                                    <field name="name"/>
                                    <field name="severity" widget="badge"/>
                                    <field name="confidence" widget="progressbar"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cg_incident_view_graph" model="ir.ui.view">
        <field name="name">cg.incident.graph</field>
        <field name="model">cg.incident</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1" class="cg_glass_view">
                <field name="category"/>
                <field name="stage"/>
            </graph>
        </field>
    </record>

    <record id="cg_incident_action" model="ir.actions.act_window">
        <field name="name">Security Incidents</field>
        <field name="res_model">cg.incident</field>
        <field name="view_mode">kanban,list,form,graph</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No incidents to investigate</p>
            <p>Report one manually, or convert a Wazuh alert into an incident from the alert list.</p>
        </field>
    </record>

    <record id="cg_incident_report_action" model="ir.actions.act_window">
        <field name="name">Report an Incident</field>
        <field name="res_model">cg.incident</field>
        <field name="view_mode">form</field>
    </record>

    <record id="cg_incident_my_action" model="ir.actions.act_window">
        <field name="name">My Reported Incidents</field>
        <field name="res_model">cg.incident</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('reporter_id', '=', uid)]</field>
    </record>
</odoo>
