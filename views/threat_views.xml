<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ INDICATORS -->
    <record id="cg_ioc_view_search" model="ir.ui.view">
        <field name="name">cg.ioc.search</field>
        <field name="model">cg.ioc</field>
        <field name="arch" type="xml">
            <search>
                <field name="value"/>
                <filter name="malicious" string="Malicious" domain="[('reputation', '=', 'malicious')]"/>
                <filter name="suspicious" string="Suspicious" domain="[('reputation', '=', 'suspicious')]"/>
                <separator/>
                <filter name="external" string="External" domain="[('scope', '=', 'external')]"/>
                <filter name="internal" string="Internal" domain="[('scope', '=', 'internal')]"/>
                <separator/>
                <filter name="ips" string="IP Addresses" domain="[('ioc_type', '=', 'ip')]"/>
                <filter name="domains" string="Domains" domain="[('ioc_type', '=', 'domain')]"/>
                <filter name="hashes" string="File Hashes" domain="[('ioc_type', '=', 'hash')]"/>
                <filter name="urls" string="URLs" domain="[('ioc_type', '=', 'url')]"/>
                <separator/>
                <filter name="observed" string="Seen in Alerts" domain="[('alert_ids', '!=', False)]"/>
                <filter name="threatfox" string="ThreatFox Feed" domain="[('source', 'ilike', 'ThreatFox')]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'ioc_type'}"/>
                    <filter name="group_reputation" string="Reputation" context="{'group_by': 'reputation'}"/>
                    <filter name="group_scope" string="Scope" context="{'group_by': 'scope'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="cg_ioc_view_list" model="ir.ui.view">
        <field name="name">cg.ioc.list</field>
        <field name="model">cg.ioc</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" class="cg_glass_view">
                <header>
                    <!-- display="always": the import does not act on selected rows, so it must be reachable on an empty list too -->
                    <button name="action_import_threatfox" type="object" string="Import ThreatFox" icon="fa-cloud-download" display="always"
                            confirm="Download the indicators published by abuse.ch ThreatFox in the last 3 days? Only your Auth-Key is sent."/>
                    <button name="action_reassess" type="object" string="Reassess"/>
                    <button name="action_enrich_external" type="object" string="Enrich with VirusTotal"/>
                </header>
                <field name="value" class="cg_mono fw-bold"/>
                <field name="ioc_type" widget="badge"/>
                <field name="scope"/>
                <field name="reputation" widget="badge" decoration-danger="reputation == 'malicious'" decoration-warning="reputation == 'suspicious'" decoration-success="reputation == 'clean'" decoration-muted="reputation == 'unknown'"/>
                <field name="score" widget="progressbar"/>
                <field name="alert_count" string="Alerts"/>
                <field name="technique_ids" widget="many2many_tags"/>
                <field name="first_seen" optional="show"/>
                <field name="last_seen"/>
                <field name="source" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="cg_ioc_view_form" model="ir.ui.view">
        <field name="name">cg.ioc.form</field>
        <field name="model">cg.ioc</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" class="cg_glass_view">
                <header>
                    <button name="action_threat_report" type="object" string="Generate Threat Report" class="btn-primary" icon="fa-magic"/>
                    <button name="action_reassess" type="object" string="Reassess from Local Evidence"/>
                    <button name="action_enrich_external" type="object" string="Enrich Externally" icon="fa-globe"
                            confirm="This sends the indicator value (never log content) to VirusTotal. Continue?"/>
                    <field name="reputation" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_alerts" icon="fa-bell-o">
                            <field name="alert_count" widget="statinfo" string="Alerts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="cg_ref"><field name="ioc_type"/></span>
                        <h1><field name="value" class="cg_mono" placeholder="203.0.113.45"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="score" widget="progressbar"/>
                            <field name="scope"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="first_seen"/>
                            <field name="last_seen"/>
                        </group>
                    </group>
                    <group>
                        <field name="technique_ids" widget="many2many_tags"/>
                        <field name="asset_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Intelligence" name="intel">
                            <field name="enrichment" readonly="1"/>
                        </page>
                        <page string="Related Alerts" name="alerts">
                            <field name="alert_ids" readonly="1">
                                <list limit="15">
                                    <field name="timestamp"/>
                                    <field name="name"/>
                                    <field name="asset_id"/>
                                    <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-info="severity == 'medium'" decoration-muted="severity == 'low'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Analyst Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cg_ioc_action" model="ir.actions.act_window">
        <field name="name">Indicators of Compromise</field>
        <field name="res_model">cg.ioc</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_external': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No indicators yet</p>
            <p>IP addresses, domains and file hashes are extracted automatically from imported alerts.</p>
        </field>
    </record>

    <!-- ============================================================ MITRE ATT&CK -->
    <record id="cg_mitre_view_search" model="ir.ui.view">
        <field name="name">cg.mitre.technique.search</field>
        <field name="model">cg.mitre.technique</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="tactic"/>
                <filter name="observed" string="Observed" domain="[('alert_ids', '!=', False)]"/>
                <group>
                    <filter name="group_tactic" string="Tactic" context="{'group_by': 'tactic'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="cg_mitre_view_kanban" model="ir.ui.view">
        <field name="name">cg.mitre.technique.kanban</field>
        <field name="model">cg.mitre.technique</field>
        <field name="arch" type="xml">
            <kanban class="cg_kanban cg_glass_view" default_group_by="tactic" records_draggable="0" create="0" delete="0">
                <field name="alert_count"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="cg_card {{record.alert_count.raw_value ? 'cg_edge_high' : 'cg_edge_none'}}">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="cg_mono cg_card_sub"><field name="code"/></span>
                                <span t-if="record.alert_count.raw_value" class="cg_score_pill cg_bg_high"><field name="alert_count"/></span>
                            </div>
                            <field name="name" class="cg_card_title"/>
                            <div class="cg_card_sub cg_clamp"><field name="description"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="cg_mitre_view_list" model="ir.ui.view">
        <field name="name">cg.mitre.technique.list</field>
        <field name="model">cg.mitre.technique</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0" class="cg_glass_view">
                <field name="code" class="cg_mono fw-bold"/>
                <field name="name"/>
                <field name="tactic"/>
                <field name="alert_count" string="Alerts"/>
            </list>
        </field>
    </record>

    <record id="cg_mitre_view_form" model="ir.ui.view">
        <field name="name">cg.mitre.technique.form</field>
        <field name="model">cg.mitre.technique</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0" class="cg_glass_view">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_alerts" icon="fa-bell-o">
                            <field name="alert_count" widget="statinfo" string="Alerts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="cg_ref"><field name="code" placeholder="T1110"/></span>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="tactic"/>
                        <field name="url" widget="url"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cg_mitre_action" model="ir.actions.act_window">
        <field name="name">MITRE ATT&amp;CK Coverage</field>
        <field name="res_model">cg.mitre.technique</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
