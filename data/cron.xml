<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_wazuh_sync" model="ir.cron">
        <field name="name">CyberGuard: synchronise Wazuh alerts and agents</field>
        <field name="model_id" ref="model_cg_wazuh_config"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="cron_daily_summary" model="ir.cron">
        <field name="name">CyberGuard: daily AI security summary</field>
        <field name="model_id" ref="model_cg_ai_analysis"/>
        <field name="state">code</field>
        <field name="code">model.cron_daily_summary()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_escalate_incidents" model="ir.cron">
        <field name="name">CyberGuard: escalate incidents past SLA</field>
        <field name="model_id" ref="model_cg_incident"/>
        <field name="state">code</field>
        <field name="code">model.cron_escalate_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="cron_remediation_reminders" model="ir.cron">
        <field name="name">CyberGuard: remediation reminders</field>
        <field name="model_id" ref="model_cg_vulnerability"/>
        <field name="state">code</field>
        <field name="code">model.cron_remediation_reminders()
env['cg.risk'].cron_review_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
